{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": "src",
    "types": []
  },
  "include": [
    "src/types/**/*.ts",
    "src/utils/**/*.ts",
    "src/repositories/**/*.ts",
    "src/database/demo.ts",
    "src/database/storage.types.ts"
  ]
}
